<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- হেডার কার্ড ও লোগো -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:background="@drawable/bg_icon_container"
        android:padding="16dp"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/imgShield"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="8dp"
            android:src="@drawable/bg_icon_container" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/secure_badge"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- লাইসেন্স কি ইনপুট বক্স -->
    <EditText
        android:id="@+id/etLicenseKey"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_badge_secure"
        android:hint="@string/hint_license"
        android:inputType="textVisiblePassword"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_gray"
        android:textSize="16sp"
        android:layout_marginBottom="20dp" />

    <!-- ভেরিফাই ও লঞ্চ বাটন -->
    <Button
        android:id="@+id/btnVerify"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_gradient_button"
        android:text="@string/verify_launch"
        android:textColor="@color/primary_dark"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
